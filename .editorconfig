# 统一编辑器配置（EditorConfig）
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{js,mjs,vue,json,ts}]
indent_style = space
indent_size = 2

[*.{toml,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown 里行尾两个空格表示换行，不能一律裁掉
trim_trailing_whitespace = false
max_line_length = off

[*.{csv,txt,jsonl}]
# 数据产物不参与风格约束
insert_final_newline = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
