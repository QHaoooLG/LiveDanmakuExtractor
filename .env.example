# 环境变量模式：设置后凭据只存在于进程内存，完全不落盘。
# 复制本文件为 .env 并填入（.env 已在 .gitignore 中）。
#
# 安全提示：SESSDATA 等价于账号登录态，泄露即可被用于以你的身份操作。
# 优先使用 `bili-danmaku login` 扫码，无需手抄凭据。

BILI_SESSDATA=
BILI_BILI_JCT=
BILI_DEDE_USER_ID=
BILI_BUVUD3=

# 日志级别：DEBUG / INFO / WARNING / ERROR
BILI_LOG_LEVEL=INFO

# 数据输出目录
BILI_OUT_DIR=data
